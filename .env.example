# 复制为 .env.local 后填写，.env* 已被 gitignore（本文件除外）。
# 不填任何 key 也能用（本地解读）。AI 二选一：

# ---- 方式 A：Anthropic（默认）----
ANTHROPIC_API_KEY=

# ---- 方式 B：任何 OpenAI 兼容接口（DeepSeek / OpenAI / 通义 / Kimi / 本地 Ollama、vLLM …）----
# 例（DeepSeek）：
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# 可选：换个视角用的更强模型（不设则同 OPENAI_MODEL）
# OPENAI_MODEL_DEEP=
# 可选：采样温度（不设就不传；有些模型不接受该参数）
# OPENAI_TEMPERATURE=0.3
# 可选：json_object（默认，兼容面最广）| json_schema（OpenAI 严格结构化输出）| none
# OPENAI_JSON_MODE=json_object

# 两种都配了时默认用 Anthropic；也可显式指定：anthropic | openai-compatible
# AI_PROVIDER=
