# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest 的 JSON 报告（含本机绝对路径，不进版本库）
/.vitest/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# scratch
/tmp/

# playwright
/test-results/
/playwright-report/

# 本地密钥文件，永远不提交
/deepseek/

# Cindy 协作时建在仓库内的临时 worktree，不提交
/.cindy-worktrees/
